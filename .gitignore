__pycache__/
*.py[cod]

# Raw source material is local-only. Keep only documentation/placeholders.
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# Generated ingestion state is local-only. Keep only documentation/placeholders.
data/processed/*
!data/processed/README.md
!data/processed/.gitkeep
**/ingestion-manifest.json

# Private master knowledge and review staging never enter version control.
data/private/*
!data/private/README.md
!data/private/.gitkeep
data/staging/*
!data/staging/README.md
!data/staging/.gitkeep

# Ingestion logs can contain source-derived metadata.
logs/*
!logs/README.md
!logs/.gitkeep
**/ingestion-*.jsonl
**/intake-*.jsonl

# Conversation and chat exports are private input, wherever they are placed.
**/conversations.json
**/*conversation-export*.json
**/*conversation_export*.json
**/*chat-export*.json
**/*chat_export*.json
**/*conversation-export*.zip
**/*conversation_export*.zip
**/*chat-export*.zip
**/*chat_export*.zip
**/*project-export*.json
**/*project_export*.json
**/*project-export*.zip
**/*project_export*.zip

# Temporary, backup, and editor files.
*.tmp
*.temp
*.swp
*.swo
*.bak
*~
~$*
