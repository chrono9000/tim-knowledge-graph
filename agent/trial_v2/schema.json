{
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "statement",
              "recommendation",
              "preference",
              "proposed-choice",
              "decision",
              "commitment",
              "constraint",
              "unresolved-question"
            ]
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "decisionOwner": {
            "type": [
              "string",
              "null"
            ]
          },
          "commitment": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "due": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timezone": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ambiguity": {
                    "type": "string",
                    "enum": [
                      "none",
                      "date",
                      "time",
                      "timezone"
                    ]
                  }
                },
                "required": [
                  "date",
                  "time",
                  "timezone",
                  "ambiguity"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "owner",
              "due"
            ],
            "additionalProperties": false
          },
          "amount": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "<=",
                  ">=",
                  "="
                ]
              },
              "qualifier": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "value",
              "unit",
              "operator",
              "qualifier"
            ],
            "additionalProperties": false
          },
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "messageId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "messageId",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "messageId",
          "quote",
          "kind",
          "speaker",
          "subject",
          "decisionOwner",
          "commitment",
          "amount",
          "support"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "owner-of",
              "depends-on"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "evidenceClaim": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "source",
          "target",
          "evidenceClaim"
        ],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ambiguous-reference",
              "missing-owner",
              "ambiguous-date",
              "ambiguous-time",
              "missing-timezone",
              "ambiguous-acceptance",
              "possible-conflict"
            ]
          },
          "field": {
            "type": "string",
            "enum": [
              "speaker",
              "subject",
              "decisionOwner",
              "commitment.owner",
              "commitment.due",
              "acceptance",
              "conflict"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "claimIds",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "claims",
    "relationships",
    "flags"
  ],
  "additionalProperties": false
}
