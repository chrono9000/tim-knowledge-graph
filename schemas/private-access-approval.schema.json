{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tim-knowledge-graph:private-access-approval:1",
  "title": "Local private-access design approval",
  "type": "object",
  "required": ["schemaVersion", "approved", "mode", "approvedAt", "notice"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "approved": { "const": true },
    "mode": { "enum": ["local-only", "tailscale", "cloudflare-access"] },
    "approvedAt": { "type": "string", "format": "date-time" },
    "notice": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
